<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
	<class name="project.mall.seller.model.SellerDestroyApply" table="T_SELLER_DESTROY_APPLY">
		<id name="id" type="java.lang.String">
			<column name="UUID" />
			<generator class="uuid.hex" />
		</id>
		<property name="sellerId" type="java.lang.String">
			<column name="SELLER_ID" />
		</property>
		<property name="account" type="java.lang.String">
			<column name="ACCOUNT" />
		</property>
		<property name="applyReason" type="java.lang.String">
			<column name="APPLY_REASON" />
		</property>
		<property name="status" type="java.lang.Integer">
			<column name="STATUS" />
		</property>
		<property name="applyTime" type="timestamp">
			<column name="APPLY_TIME" />
		</property>
		<property name="reviewTime" type="timestamp">
			<column name="REVIEW_TIME" />
		</property>
		<property name="reviewRemark" type="java.lang.String">
			<column name="REVIEW_REMARK" />
		</property>
		<property name="reviewerName" type="java.lang.String">
			<column name="REVIEWER_NAME" />
		</property>
	</class>
</hibernate-mapping>
